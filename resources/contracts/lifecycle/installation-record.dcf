Record-Type: installation-record-contract
Contract-ID: rrp.installation-record
Contract-Version: 0.2.0
Format-Version: 1.0.0
Product-ID: readmission-risk-pool-platform
Development-Version: 1.0.0-dev
Status: development_unpublished
Owner-Package: rrpplatform
Installation-Record-Type: rrp-installation
Fields: Record-Type,Contract-ID,Contract-Version,Installation-ID,Product-ID,Product-Version,Development-Version,Distribution-ID,Build-ID,Dependency-Specification-ID,Host-R-Executable,Host-R-Version,Platform,Architecture,Private-Library,Resource-Root,Distribution-Manifest-Digest,Private-Library-Inventory-Path,Private-Library-Inventory-Digest,Installed-At
Installation-ID-Role: local_immutable_realization_identity
Distribution-Compatibility: exact_distribution_identity
Dependency-Compatibility: exact_specification_and_verified_realization
Library-Posture: version_private_then_base_r_only
Library-Permissions: conventional_r_package_installation_permissions
Library-Inventory-Record-Type: installed-library-inventory
Library-Inventory-Fields: Record-Type,Path,Size,SHA256
Library-Inventory-Ordering: relative_path_radix
Library-Inventory-Membership: closed_regular_files_no_links
Strict-Verification-Boundaries: install_reinstall_verify_doctor_activation_rollback_verified_listing_uninstall_application_acceptance
Routine-CLI-Preflight: structural_without_full_library_hashing
Filesystem-Write-Protection: not_required
Ambient-Library-Substitution: prohibited
Project-Fields: prohibited
Project-Discovery-Or-Association: prohibited
Unintended-Modification: detected_and_rejected_at_strict_verification
Historical-Record-Compatibility: older_records_not_complete_under_this_contract
Path-In-Installation-ID: prohibited
Durable-History-Attribution: prohibited
Unknown-Fields: prohibited
Additional-Records: prohibited
