Record-Type: installed-diagnosis-contract
Contract-ID: rrp.installed-diagnosis
Contract-Version: 0.1.0
Format-Version: 1.0.0
Product-ID: readmission-risk-pool-platform
Development-Version: 1.0.0-dev
Status: development_unpublished
Owner-Package: rrpplatform
Operation-Result-Contract: rrp.contract.operation-result@0.1.0
Operation-IDs: rrp.verify-installed-software,rrp.software-doctor
Value-Fields: software_status,product_id,product_version,installation_id,distribution_id,artifact_state,target_family,build_target_r_version,build_target_platform,build_target_architecture,host_r_version,host_platform,host_architecture,eligibility_status,qualification_status,host_r_status,private_library_status,resource_status,launcher_status,activation_status,checks
Software-Status-Values: ready,ready_with_warnings,blocked
Artifact-State-Values: development,qualification_candidate,unavailable
Eligibility-Status-Values: exact_build_target_unqualified,eligible_best_effort,unavailable
Qualification-Status-Values: not_applicable,pending_external_evidence,unavailable
Qualification-Claim: external_evidence_only
Check-Fields: check_id,status,recovery_code
Check-Status-Values: pass,warning,failure
Recovery-Code-Pattern: ^[a-z][a-z0-9_]*$
Read-Only: required
Temporary-Probes: removed_before_return
Project-Input: prohibited
Project-Discovery-Or-Association: prohibited
Repair-Or-Activation: prohibited
Privacy: bounded_software_identity_and_diagnostics_only
Unknown-Fields: prohibited
Additional-Records: prohibited
