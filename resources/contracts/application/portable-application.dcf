Record-Type: portable-application-contract
Contract-ID: rrp.application.portable
Contract-Version: 0.1.0
Format-Version: 1.0.0
Product-ID: readmission-risk-pool-platform
Development-Version: 1.0.0-dev
Status: development_unpublished
Owner-Package: rrpplatform
Supplied-Application: rrp.application.supplied@0.1.0
Operation-Result-Contract: rrp.operation-result@0.1.0
Source-Members: rrp.application.portable-core,rrp.application.portable-products,rrp.application.portable-ui,rrp.application.portable-server,rrp.asset.supplied-application-css
Source-Load-Order: rrp.application.portable-core,rrp.application.portable-products,rrp.application.portable-ui,rrp.application.portable-server
Installed-Host-Adapter: project_product_access_and_bounded_branding_only
Standalone-Host-Adapter: relative_managed_set_and_frozen_presentation_only
Product-Set-Contract: rrp.product-set.initial-readmission-risk@0.1.0
Product-Representation: frozen_dcf_csv
Product-Declaration-File: products.dcf
Product-Inventory-File: inventory.dcf
Product-Member-Files: current-remaining-risk.csv,remaining-risk-trajectory.csv,operational-scope-summary.csv
Product-Declaration-Fields: Record-Type,Portable-Application-Contract-ID,Portable-Application-Contract-Version,Product-Set-Contract-ID,Product-Set-Contract-Version,Product-Set-ID,Materialization-ID,Source-Operation-Run-ID,Source-Analytical-Time,Source-History-Cutoff,Source-History-Fingerprint,Current-Remaining-Risk-Product-Contract-ID,Current-Remaining-Risk-Product-Contract-Version,Current-Remaining-Risk-Product-Instance-ID,Current-Remaining-Risk-Row-Count,Current-Remaining-Risk-File,Remaining-Risk-Trajectory-Product-Contract-ID,Remaining-Risk-Trajectory-Product-Contract-Version,Remaining-Risk-Trajectory-Product-Instance-ID,Remaining-Risk-Trajectory-Row-Count,Remaining-Risk-Trajectory-File,Operational-Scope-Summary-Product-Contract-ID,Operational-Scope-Summary-Product-Contract-Version,Operational-Scope-Summary-Product-Instance-ID,Operational-Scope-Summary-Row-Count,Operational-Scope-Summary-File
Presentation-Contract: rrp.application-presentation@0.1.0
Presentation-Fields: Record-Type,Presentation-Contract-ID,Presentation-Contract-Version,Brand-Contract-ID,Brand-Contract-Version,Source,Display-Name,Primary-Color,Logo-File,Logo-Media-Type,Logo-Alt
Presentation-Logo: optional_contained_png_or_jpeg
Initial-Provenance-Contract: rrp.application-initialization@0.1.0
Initial-Provenance-Fields: Record-Type,Contract-ID,Contract-Version,Software-Product-ID,Software-Version,Distribution-ID,Package-Version,Resource-Catalog-ID,Resource-Catalog-Version,Portable-Application-Contract-ID,Portable-Application-Contract-Version,Application-Baseline-ID,Dependency-Identity,Initial-Product-Set-ID,Initial-Materialization-ID,Source-Operation-Run-ID,Source-Analytical-Time,Source-History-Cutoff,Source-History-Fingerprint,Presentation-SHA256,Source-Inventory-SHA256,Managed-Inventory-SHA256
Initial-Provenance-Mutability: immutable_after_create
Application-Baseline-Algorithm: sha256_over_length_delimited_authority_and_inventory_evidence
Managed-Root: rrp-data
Managed-Content-Contract: rrp.application-managed-content@0.1.0
Managed-Content-Roles: product_declaration,product_member
Managed-Inventory-Fields: Record-Type,Path,Role,Byte-Size,SHA256
Managed-Digest-Algorithm: sha256
Managed-Inventory-Closure: exact
Managed-Relative-Paths: safe_nonempty_forward_slash
Managed-Absolute-Or-Traversal-Paths: prohibited
Managed-Links-Or-Nonregular-Files: prohibited
Managed-Unexpected-Files: prohibited
Hospital-Source-Under-Managed-Root: prohibited
Standalone-Direct-Dependencies: shiny,bslib,plotly,reactable
Standalone-Forbidden-Dependencies: rrpplatform,rrpruntime,readmit,brand.yml,DBI,duckdb
Standalone-Lock-Format: renv-lock-json
Standalone-Lock-Version: 1
Standalone-Lock-Package-Fields: Package,Version,Source,Repository,Requirements,Hash
Standalone-Lock-Exact-Versions: required
Standalone-Lock-Auto-Activation: prohibited
Standalone-Private-RRP-Library: prohibited
Analytical-Execution: prohibited
Project-State-Or-History-Access: prohibited
Product-Mutation: prohibited
Unknown-Fields: prohibited
Additional-Records: prohibited
