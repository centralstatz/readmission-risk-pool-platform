\name{rrp_prepare_fictional_source}
\alias{rrp_prepare_fictional_source}
\title{Prepare the Supplied Fictional Project Source}
\usage{
rrp_prepare_fictional_source(software_catalog, project_root)
}
\arguments{
\item{software_catalog}{A validated explicit-root software resource catalog.}
\item{project_root}{One explicit supplied fictional-project root.}
}
\value{A common RRP operation result with bounded fictional-source evidence.}
\description{
Executes the installed cataloged deterministic generator for only the exact
supplied fictional reference-project identity. This is not a general ingestion
or hospital source-acquisition API.
}
